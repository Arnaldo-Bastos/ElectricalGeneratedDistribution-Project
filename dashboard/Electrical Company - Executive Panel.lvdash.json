{
  "datasets": [
    {
      "name": "8c73aa11",
      "displayName": "fact_measurements_invoiced",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.fact_measurements_invoiced",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "count_diff_le_1",
            "expr": "COUNT_IF(ABS(`total_invoiced_NEW` - `total_invoiced_OLD`) <= 1)",
            "displayName": "UC-mês com diferença até R$ 1"
          },
          {
            "name": "pct_uc_mes_diff_le_1",
            "expr": "MEASURE(`count_diff_le_1`) / MEASURE(`count`)",
            "displayName": "% UC-mês com diferença até R$ 1",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "count_active_uc_mes",
            "expr": "COUNT_IF(`contract_status` = 'ACTIVE')",
            "displayName": "UC-mês Ativos"
          },
          {
            "name": "pct_active_uc_mes",
            "expr": "MEASURE(`count_active_uc_mes`) / MEASURE(`count`)",
            "displayName": "% UC-mês Ativos",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "count_active_clients",
            "expr": "COUNT(DISTINCT `customer_id`) FILTER (WHERE `contract_status` = 'ACTIVE')",
            "displayName": "Active Clients"
          },
          {
            "name": "count_total_clients",
            "expr": "COUNT(DISTINCT `customer_id`)",
            "displayName": "Total Clients"
          },
          {
            "name": "pct_active_clients",
            "expr": "MEASURE(`count_active_clients`) / MEASURE(`count_total_clients`)",
            "displayName": "% Clientes Ativos",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "displayName": "Receita Não Faturada (NEW - OLD)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "revenue_not_invoiced",
            "expr": "SUM(`total_invoiced_NEW`) - SUM(`total_invoiced_OLD`)",
            "comment": "Diferença entre o total que deveria ser faturado pelo modelo novo (NEW) e o efetivamente faturado pelo ERP (OLD). Positivo = receita que deixou de ser faturada."
          },
          {
            "displayName": "Total a Ressarcir aos Clientes",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "total_refund_to_customers",
            "expr": "SUM(`total_refund_to_customer`)",
            "comment": "Soma dos valores a ressarcir por faturamento incorreto (modelo novo versus ERP)."
          }
        ]
      }
    }
  ],
